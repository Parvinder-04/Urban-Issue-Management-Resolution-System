# UIMRS public environment configuration example.
# Copy this file to .env only if your launcher reads it. The public setup and
# start scripts set these values for the current process automatically.
# Never commit .env, local_data/ or real secrets.

# Required in production. Use at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-unique-secret

# development or production
UIMRS_ENV=development

# india (default) or legacy
UIMRS_FRONTEND_MODE=india

# Optional. The public setup script defaults to local_data/uimrs_public.db.
# Use an absolute path in your own environment.
# DATABASE_URL=sqlite:///C:/path/to/UIMRS/local_data/uimrs_public.db

# Optional comma-separated origins for a separately hosted frontend.
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional evidence upload directory. Defaults to local_data/uploads.
# UPLOAD_DIR=C:/path/to/UIMRS/local_data/uploads

# Optional maximum upload size in MB.
# MAX_UPLOAD_SIZE_MB=10
