# UIMRS environment configuration example.
# Copy this file to .env and replace placeholder values.
# Never commit .env or real secrets.

# Required in production. Use at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-unique-secret

# development or production
UIMRS_ENV=development

# india or legacy
UIMRS_FRONTEND_MODE=india

# Optional. Defaults to sqlite:///.../uimrs_india_dev.db
# DATABASE_URL=sqlite:///C:/path/to/uimrs_india_dev.db

# Optional comma-separated origins.
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional upload directory.
# UPLOAD_DIR=C:/path/to/uploads

# Optional maximum upload size in MB.
# MAX_UPLOAD_SIZE_MB=10
